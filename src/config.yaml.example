misc:
  hide_status_window: false
  # Utisaj muziku/video iz drugih aplikacija dok traje snimanje (samo Windows).
  mute_audio_while_recording: false
  # Kratak bip kad snimanje pocne i kad se zavrsi.
  recording_beeps: true
  noise_on_completion: false
  print_to_terminal: true
model_options:
  api:
    api_key: null
    base_url: https://api.openai.com/v1
    model: whisper-1
  common:
    # Kratak opis teme i retke reci koje ce se pojavljivati - model ih tada ređe greši.
    initial_prompt: 'Diktiram na srpskom, latinicom, sa pravilnim znakovima interpunkcije.'
    language: sr
    temperature: 0.0
  local:
    compute_type: int8
    condition_on_previous_text: true
    device: cpu
    # large-v3-turbo je najtačniji za srpski (~1,6 GB). small je duplo brži, ali greši mnogo više.
    model: large-v3-turbo
    model_path: null
    vad_filter: true
    # 0 = koristi sva fizička jezgra procesora.
    cpu_threads: 0
  use_api: false
post_processing:
  add_trailing_space: true
  input_method: pynput
  remove_capitalization: false
  remove_trailing_period: false
  # Briše poštapalice (ovaj, znači, kako se zove, eee...) kad stoje same između zareza.
  remove_fillers: true
  writing_key_press_delay: 0.005
recording_options:
  # Precica moze biti kombinacija tastera ('ctrl+shift+space', 'f9')
  # ili taster misa: 'mouse_middle' (tockic), 'mouse_back', 'mouse_forward'.
  # Vise alternativnih precica se razdvaja zarezom, npr:
  #   activation_key: mouse_middle, ctrl+alt+space
  activation_key: f9
  input_backend: auto
  min_duration: 100
  # hold_to_record = snima dok drzis taster; press_to_toggle = prvi pritisak
  # pokrece snimanje, drugi pritisak ga zaustavlja.
  recording_mode: hold_to_record
  sample_rate: 16000
  silence_duration: 900
  sound_device: null
